<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect: import SpO2, read/write blood pressure,
         plus the v2.0 dashboard reads and "+ Log" writes. -->
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />

    <!-- Watch installer: ADB-over-Wi-Fi socket to the watch -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Result notifications when a new BP estimate is ready -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Extreme watch alerts take over the screen with a full-screen intent -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Health Connect: package visibility is required on Android 11+ for the
         permission request to resolve. Without this the Connect button fails
         silently and the app never appears in Health Connect's app list. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:label="BPWatch"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BpWatch">
        <activity
            android:name="com.fourgeailabs.bpwatch.mobile.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect (Android 13 and below): rationale entry point so
                 the HC app can deep-link into us for "why does this app want
                 this data?". Without it HC ignores the app. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect (Android 14+): permission-rationale entry point.
             The system will NOT present the permission request at all if this
             alias is missing — the request silently returns 0 granted and the
             app never appears in Health Connect's app list. Health Connect
             opens our MainActivity with the rationale intent; the user can
             read why we need the data in Settings. -->
        <activity-alias
            android:name="com.fourgeailabs.bpwatch.mobile.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.fourgeailabs.bpwatch.mobile.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Full-screen takeover for extreme watch alerts. Fires over the
             lock screen; dismissed only with a swipe. -->
        <activity
            android:name="com.fourgeailabs.bpwatch.mobile.ui.PhoneAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!-- Receives heart-rate readings from the watch -->
        <service
            android:name="com.fourgeailabs.bpwatch.mobile.wearable.PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bpwatch" />
            </intent-filter>
        </service>
    </application>
</manifest>
