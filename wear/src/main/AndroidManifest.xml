<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Monitoring & alerts (v1.13): alert notifications, alert vibration,
         and the continuous heart-rate foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <application
        android:label="BPWatch"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault">
        <activity
            android:name="com.fourgeailabs.bpwatch.wear.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name="com.fourgeailabs.bpwatch.wear.WatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bpwatch" />
            </intent-filter>
            <!-- One-tap updater (v1.15+): the APK arrives as a DataItem. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bpwatch" />
            </intent-filter>
        </service>

        <!-- Result of a self-update install session (v1.15+). -->
        <receiver
            android:name="com.fourgeailabs.bpwatch.wear.UpdateResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.fourgeailabs.bpwatch.wear.UPDATE_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Continuous heart-rate monitoring: foreground service, health type
             (API 34+ requires the type declared here plus the
             FOREGROUND_SERVICE_HEALTH permission). -->
        <service
            android:name="com.fourgeailabs.bpwatch.wear.HrMonitorService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Full-screen threshold alert, launched from the alert notification. -->
        <activity
            android:name="com.fourgeailabs.bpwatch.wear.AlertActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <receiver
            android:name="com.fourgeailabs.bpwatch.wear.HourlyCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.fourgeailabs.bpwatch.wear.HOURLY_CHECK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.fourgeailabs.bpwatch.wear.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
    </application>
</manifest>
